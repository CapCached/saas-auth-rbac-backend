{
  "name": "saas-auth-rbac-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Production-style multi-tenant authentication and RBAC service",
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run lint && npm run typecheck && npm run openapi:lint && npm run test && npm run build",
    "dev": "tsx watch src/server.ts",
    "keys:generate": "tsx scripts/generate-keypair.ts",
    "lint": "eslint . --max-warnings=0",
    "migrate": "tsx src/db/migrate.ts",
    "openapi:lint": "redocly lint openapi/openapi.yaml --extends minimal",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "RUN_INTEGRATION_TESTS=true vitest run tests/integration",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "argon2": "^0.45.1",
    "fastify": "^5.12.0",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.9",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.46.1",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
