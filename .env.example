# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:3001

# Stores
DATABASE_URL=postgres://auth:auth@localhost:5432/auth
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379

# JWT. Development generates an ephemeral Ed25519 key when these are blank.
# Production requires a PKCS#8 private key and at least one matching SPKI public key.
JWT_ISSUER=https://auth.example.com
JWT_AUDIENCE=https://api.example.com
JWT_ACTIVE_KID=primary-2026-01
JWT_PRIVATE_KEY_BASE64=
# JSON object: {"primary-2026-01":"<base64 SPKI PEM>"}
JWT_PUBLIC_KEYS_JSON={}
ACCESS_TOKEN_TTL_SECONDS=300
REFRESH_TOKEN_TTL_DAYS=30

# Generate each with: openssl rand -base64 32
TOKEN_PEPPER=replace-with-at-least-32-random-characters
PASSWORD_PEPPER=replace-with-at-least-32-random-characters

# Operations
METRICS_TOKEN=replace-in-production
WORKER_ENABLED=true
OUTBOX_WEBHOOK_URL=
OUTBOX_WEBHOOK_SECRET=
RATE_LIMIT_FAIL_CLOSED=true
